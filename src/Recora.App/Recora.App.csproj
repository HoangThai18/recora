<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Recora</AssemblyName>
    <RootNamespace>Recora.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\recora.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <ProjectReference Include="..\Recora.Core\Recora.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Recora.Core\Polyfills.cs" Link="Polyfills.cs" />
    <EmbeddedResource Include="Assets\recora.ico" LogicalName="Recora.App.Assets.recora.ico" />
    <EmbeddedResource Include="Assets\recora-256.png" LogicalName="Recora.App.Assets.recora-256.png" />
  </ItemGroup>

</Project>
